#include <windows.h>

// Icons (101 is primary executable icon in Windows Explorer)
101 ICON "assets\\logo_blue.ico"
102 ICON "assets\\logo_green.ico"
103 ICON "assets\\logo_purple.ico"
104 ICON "assets\\logo_red.ico"
105 ICON "assets\\logo_orange.ico"

// Application Version & Description
1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "System Monitor"
            VALUE "FileDescription",  "System Monitor"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "SystemMonitor"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "SystemMonitor.exe"
            VALUE "ProductName",      "System Monitor"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
